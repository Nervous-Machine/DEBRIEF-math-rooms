H : SimpleGraph W
u : W
D : SimpleGraph V
f : (SimpleGraph.induce {u}ᶜ H).Copy D
x : V
hx : x ∉ Set.range ⇑f
hadj : ∀ (w : ↑{u}ᶜ), H.Adj u ↑w → D.Adj x (f w)
a b : W
hab : H.Adj a b
ha : a = u
hb : b ≠ u
⊢ H.Adj u ↑⟨b, ⋯⟩
